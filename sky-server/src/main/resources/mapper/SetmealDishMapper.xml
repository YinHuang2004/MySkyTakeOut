<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.SetmealDishMapper">

    <!-- 根据菜品id集合统计关联的套餐数量 -->
    <select id="countRelateSetmeal" resultType="java.lang.Long">
        select count(*)
        from setmeal_dish
        where dish_id in
        <foreach collection="list" item="dishId" separator="," open="(" close=")">
            #{dishId}
        </foreach>
    </select>

    <!-- 批量插入套餐菜品关系 -->
    <insert id="insertBatch">
        insert into setmeal_dish (setmeal_id, dish_id, name, price, copies)
        values
        <foreach collection="list" item="sd" separator=",">
            (#{sd.setmealId}, #{sd.dishId}, #{sd.name}, #{sd.price}, #{sd.copies})
        </foreach>
    </insert>

    <!-- 根据套餐id集合批量删除套餐菜品关系 -->
    <delete id="deleteBySetmealIds">
        delete from setmeal_dish
        where setmeal_id in
        <foreach collection="list" item="setmealId" separator="," open="(" close=")">
            #{setmealId}
        </foreach>
    </delete>

    <!-- 根据套餐id查询套餐菜品关系 -->
    <select id="getBySetmealId" resultType="com.sky.entity.SetmealDish">
        select * from setmeal_dish where setmeal_id = #{setmealId}
    </select>

</mapper>