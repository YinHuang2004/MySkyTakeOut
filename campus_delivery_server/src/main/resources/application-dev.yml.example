# 本文件为配置模板：复制为 application-dev.yml 并填入你自己的真实配置后，项目才能启动
# cp application-dev.yml.example application-dev.yml

campus_delivery:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: campus_delivery
    username: root
    password: your-mysql-password
  redis:
    host: localhost
    port: 6379
    password: your-redis-password
    database: 10
  alioss:
    endpoint: oss-cn-beijing.aliyuncs.com
    access-key-id: your-oss-access-key-id
    access-key-secret: your-oss-access-key-secret
    bucket-name: your-bucket-name
  wechat:
    appid: your-wechat-appid
    secret: your-wechat-secret
    mchid: your-mchid
    mchSerialNo: your-mch-serial-no
    privateKeyFilePath: your-apiclient-key.pem-path
    apiV3Key: your-api-v3-key
    weChatPayCertFilePath: your-wechat-pay-cert-path
    notifyUrl: https://your-domain.com/wxpay/notify
    refundNotifyUrl: https://your-domain.com/wxpay/refund-notify
  jwt:
    admin-secret-key: your-admin-jwt-secret
    user-secret-key: your-user-jwt-secret
  shop:
    address: 店铺营业地址（用于百度地图检索配送距离）
  baidu:
    ak: your-baidu-map-ak
